# ---- local models (compose stack) ----
# gateway talks to the litellm container, which fronts Ollama
LOCAL_MODEL=ollama/llama3.1:8b-instruct-q4_K_M
CLOUD_MODEL=gpt-4o-mini
OPENAI_API_KEY=            # optional: enables the cloud lane + Ragas judging locally

# ---- providers (OpenAI-compatible; compose overrides these for local dev) ----
# defaults target hosted free tiers so the gateway also runs without compose:
CHAT_LOCAL_BASE_URL=https://api.groq.com/openai/v1
CHAT_LOCAL_MODEL=openai/gpt-oss-20b
CHAT_CLOUD_BASE_URL=https://api.groq.com/openai/v1
CHAT_CLOUD_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=
EMBED_BASE_URL=https://api.jina.ai/v1
EMBED_MODEL=jina-embeddings-v3
EMBED_DIMENSIONS=1024      # must match EMBEDDING_DIM
JINA_API_KEY=

# ---- gateway ----
GATEWAY_PORT=8000
REDIS_URL=redis://redis:6379/0
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tokenroute
EMBEDDING_DIM=1024
CACHE_THRESHOLD=0.92       # semantic cache similarity cutoff (0..1)
RATE_LIMIT_PER_MINUTE=30

# ---- langfuse (optional, cloud free tier) ----
# tracing is a no-op until these are set
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ---- web ----
WEB_PORT=3000
GATEWAY_INTERNAL_URL=http://localhost:8000

# ---- self-serve signup (web, optional) ----
# Google OAuth client for Auth.js; without these /dashboard stays behind a
# clean login error and the rest of the app works
AUTH_SECRET=               # openssl rand -hex 32
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# gateway admin API shared secret - the web app uses it server-side to
# provision tenants/keys after sign-in
ADMIN_KEY=

# ---- multi-tenancy (hosted mode) ----
# off by default so local dev and the public demo stay keyless. When on,
# /v1 and /chat require a tenant API key (Bearer).
TENANCY_ENABLED=false
BYOK_MASTER_KEY=           # python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
# optional extra chat providers for explicit "provider:model" requests
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# web-only: tenant key the public homepage demo runs under when tenancy is on
GATEWAY_DEMO_KEY=

# ---- guardrails ----
GUARDRAILS_MODE=off        # off | log | block

# ---- billing (hosted control plane; dormant until configured) ----
BILLING_PROVIDER=          # razorpay | stripe
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_ID_PRO=
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PRO=
