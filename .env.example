# ---- local models (compose stack) ----
# gateway talks to the litellm container, which fronts Ollama
LOCAL_MODEL=ollama/llama3.1:8b-instruct-q4_K_M
CLOUD_MODEL=gpt-4o-mini
OPENAI_API_KEY=            # optional: enables the cloud lane + Ragas judging locally

# ---- providers (OpenAI-compatible; compose overrides these for local dev) ----
# defaults target hosted free tiers so the gateway also runs without compose:
CHAT_LOCAL_BASE_URL=https://api.groq.com/openai/v1
CHAT_LOCAL_MODEL=openai/gpt-oss-20b
CHAT_CLOUD_BASE_URL=https://api.groq.com/openai/v1
CHAT_CLOUD_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=
EMBED_BASE_URL=https://api.jina.ai/v1
EMBED_MODEL=jina-embeddings-v3
EMBED_DIMENSIONS=1024      # must match EMBEDDING_DIM
JINA_API_KEY=

# ---- gateway ----
GATEWAY_PORT=8000
REDIS_URL=redis://redis:6379/0
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tokenroute
EMBEDDING_DIM=1024
CACHE_THRESHOLD=0.92       # semantic cache similarity cutoff (0..1)
RATE_LIMIT_PER_MINUTE=30

# ---- langfuse (optional, cloud free tier) ----
# tracing is a no-op until these are set
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ---- web ----
WEB_PORT=3000
GATEWAY_INTERNAL_URL=http://localhost:8000
