# ---- models ----
# local model served by ollama (pulled automatically on first run)
LOCAL_MODEL=ollama/llama3.1:8b-instruct-q4_K_M
EMBED_MODEL=ollama/nomic-embed-text
# cloud fallback; leave key empty to run local-only
CLOUD_MODEL=gpt-4o-mini
OPENAI_API_KEY=

# ---- gateway ----
GATEWAY_PORT=8000
LITELLM_BASE_URL=http://litellm:4000
LITELLM_MASTER_KEY=sk-tokenroute-dev
REDIS_URL=redis://redis:6379/0
DATABASE_URL=postgresql://postgres:postgres@db:5432/tokenroute
# semantic cache similarity threshold (0..1); higher = stricter
CACHE_THRESHOLD=0.92
# per-IP rate limit for /chat
RATE_LIMIT_PER_MINUTE=30

# ---- langfuse (optional, cloud free tier) ----
# tracing is a no-op until these are set
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ---- web ----
WEB_PORT=3000
GATEWAY_INTERNAL_URL=http://gateway:8000
